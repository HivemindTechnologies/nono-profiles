{
  "meta": {
    "name": "cursor",
    "description": "Cursor IDE (Electron GUI). Self-contained: extends only nono's built-in `default`. Host unix sockets (D-Bus, nix-daemon, ssh-agent) and /tmp are blocked. Start via launch.sh, which grants the workdir, the per-instance home and the Wayland socket."
  },
  "extends": "default",
  "groups": {
    "include": ["nix_runtime", "git_config"],
    "exclude": ["system_write_linux"]
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "filesystem": {
    "allow": [
      "/dev/pts",
      "/proc"
    ],
    "allow_file": [
      "/dev/null",
      "/dev/zero",
      "/dev/full",
      "/dev/tty"
    ],
    "read": [
      "/etc",
      "/sys/devices/system/cpu"
    ]
  },
  "environment": {
    "deny_vars": [
      "DBUS_SESSION_BUS_ADDRESS",
      "DISPLAY",
      "SSH_AUTH_SOCK",
      "SSH_ASKPASS",
      "SUDO_ASKPASS",
      "XDG_RUNTIME_DIR",
      "XDG_CONFIG_HOME",
      "XDG_CACHE_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME"
    ],
    "set_vars": {
      "NIXOS_OZONE_WL": "1"
    }
  }
}
