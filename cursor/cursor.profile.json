{
  "meta": {
    "name": "cursor",
    "description": "Cursor IDE (Electron GUI). Self-contained: extends only nono's built-in `default`. Host unix sockets (D-Bus, nix-daemon, ssh-agent, and all sockets in /tmp) are blocked. The project dir is the current directory ($WORKDIR); Cursor's HOME and TMPDIR live in $WORKDIR/.cursor-nono. Start with `nono run --profile <this file> -- cursor` from the project dir. See README.md for why each grant exists."
  },
  "extends": "default",
  "groups": {
    "include": ["nix_runtime", "git_config"],
    "exclude": ["system_write_linux"]
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "/tmp",
      "/dev/pts",
      "/proc"
    ],
    "allow_file": [
      "/dev/null",
      "/dev/zero",
      "/dev/full",
      "/dev/tty"
    ],
    "unix_socket": [
      "/run/nscd/socket",
      "$XDG_RUNTIME_DIR/wayland-1"
    ],
    "unix_socket_subtree_bind": [
      "$WORKDIR"
    ],
    "read": [
      "/etc",
      "/sys/devices/system/cpu"
    ]
  },
  "environment": {
    "deny_vars": [
      "DBUS_SESSION_BUS_ADDRESS",
      "DISPLAY",
      "SSH_AUTH_SOCK",
      "SSH_ASKPASS",
      "SUDO_ASKPASS",
      "XDG_RUNTIME_DIR",
      "XDG_CONFIG_HOME",
      "XDG_CACHE_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME"
    ],
    "set_vars": {
      "HOME": "$WORKDIR/.cursor-nono/home",
      "TMPDIR": "$WORKDIR/.cursor-nono/tmp",
      "WAYLAND_DISPLAY": "$XDG_RUNTIME_DIR/wayland-1",
      "NIXOS_OZONE_WL": "1",
      "GIT_CONFIG_GLOBAL": "$HOME/.config/git/config",
      "GIT_CONFIG_COUNT": "1",
      "GIT_CONFIG_KEY_0": "core.excludesFile",
      "GIT_CONFIG_VALUE_0": "$HOME/.config/git/ignore"
    }
  },
  "command_args": [
    "--ozone-platform=wayland",
    "--disable-gpu",
    "--disable-dev-shm-usage",
    "--password-store=basic",
    "$WORKDIR"
  ]
}
