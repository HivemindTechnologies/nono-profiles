#!/usr/bin/env bash
# One sandboxed Cursor per project directory (default: current directory).
# Each project gets its own instance: its own login, settings and extensions.
# Usage: cursor-nono [dir] [cursor args...]
set -euo pipefail
dir=$(realpath "${1:-.}")
shift || true
# systemd-escape maps each path to a unique name (/a-b/c and /a/b-c differ),
# so two projects never share an instance dir or a single-instance socket.
slug=$(systemd-escape --path "$dir")
exec "$(dirname "$(realpath "$0")")/../launch.sh" "$dir" "per-project/$slug" "$@"
