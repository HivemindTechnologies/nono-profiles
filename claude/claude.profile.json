{
  "meta": {
    "name": "claude",
    "description": "Claude Code CLI. Self-contained: extends only nono's built-in `default`. Host unix sockets (D-Bus, nix-daemon, ssh-agent, Wayland, tmux) are blocked. The project dir is the current directory ($WORKDIR). Start via the flake's claude-nono."
  },
  "extends": "default",
  "groups": {
    "include": ["nix_runtime", "git_config"],
    "exclude": ["system_write_linux"]
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "/tmp",

      "$HOME/.claude",

      "$HOME/.cargo",
      "$HOME/.rustup",
      "$HOME/.sbt",
      "$HOME/.ivy2",
      "$HOME/.npm",
      "$HOME/.cache/uv"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.claude.lock",
      "/dev/null",
      "/dev/zero",
      "/dev/tty"
    ],
    "read_file": [
      "/etc/passwd",
      "/etc/group"
    ]
  },
  "environment": {
    "deny_vars": [
      "DBUS_SESSION_BUS_ADDRESS",
      "DISPLAY",
      "WAYLAND_DISPLAY",
      "SSH_AUTH_SOCK",
      "SSH_ASKPASS",
      "SUDO_ASKPASS",
      "XDG_RUNTIME_DIR"
    ]
  },
  "open_urls": {
    "allow_origins": [
      "https://claude.ai",
      "https://claude.com",
      "https://platform.claude.com",
      "https://console.anthropic.com"
    ],
    "allow_localhost": true
  },
  "platform_overrides": {
    "linux": {
      "filesystem": {
        "allow": [
          "$HOME/.cache/claude",
          "$HOME/.cache/claude-cli-nodejs",
          "$HOME/.local/state/claude",
          "$HOME/.cache/coursier",
          "$HOME/.local/share/pnpm",
          "$HOME/.cache/pip",
          "/dev/pts"
        ],
        "allow_file": [
          "/dev/full"
        ],
        "unix_socket": [
          "/run/nscd/socket"
        ],
        "read_file": [
          "/etc/machine-id"
        ]
      }
    },
    "macos": {
      "filesystem": {
        "allow": [
          "$HOME/Library/Caches/claude-cli-nodejs",
          "$HOME/Library/Caches/Coursier",
          "$HOME/Library/pnpm",
          "$HOME/Library/Caches/pip"
        ]
      },
      "unsafe_macos_seatbelt_rules": [
        "(deny network-outbound (regex \"^/\"))",
        "(allow network-outbound (path \"/private/var/run/mDNSResponder\"))",
        "(allow network-outbound (path \"/var/run/mDNSResponder\"))"
      ]
    }
  }
}
