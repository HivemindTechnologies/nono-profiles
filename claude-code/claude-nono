#!/usr/bin/env bash
# Run Claude Code inside the nono sandbox defined by claude-code.profile.json.
# The profile grants the current directory as the only project directory.
#
# Usage: claude-nono [claude args...]
# CLAUDE_BIN selects the Claude Code binary (default: `claude` from PATH). It must be
# the plain binary, not another sandbox wrapper.
set -euo pipefail

# The profile sets TMPDIR to this dir (the shared /tmp is blocked). nono silently
# skips grants for missing paths, so the dir must exist before nono starts.
mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/claude-nono/tmp"

# `nono run` (not `nono wrap`) keeps a supervisor process. Only the supervisor
# can enforce the profile's unix socket rules and open login URLs in your browser.
exec nono run \
  --profile "$(dirname "$(realpath "$0")")/claude-code.profile.json" \
  -- "${CLAUDE_BIN:-claude}" "$@"
